# 이 파일을 복사해서 .env 로 저장하고 실제 값을 입력하세요
# .env 파일은 절대 git에 올라가지 않습니다

# Flask 시크릿 키 (랜덤 문자열로 변경하세요)
FLASK_SECRET_KEY=your-secret-key-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Kakao OAuth
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# 배포 URL (Railway 배포 시 실제 URL로 변경)
BASE_URL=http://127.0.0.1:5000

# 데이터베이스 (Railway PostgreSQL 사용 시 자동 설정됨)
# DATABASE_URL=postgresql://user:pass@host/dbname

# Groq AI (주가 변동 이유 분석 - 무료)
# https://console.groq.com 에서 발급
GROQ_API_KEY=your-groq-api-key

# ── AI 공급자 (위에서부터 차례로 시도, 429·5xx·타임아웃이면 다음으로) ──
# 1) 주력: Google Gemini (https://aistudio.google.com 에서 발급)
GEMINI_API_KEY=your-gemini-api-key
# 2) 백업: 위 GROQ_API_KEY (Groq, OpenAI 호환)
# 3) 추가 백업(선택): 아무 OpenAI 호환 API — 예: OpenRouter, Cerebras 등. 세 값 모두 있어야 사용
#    AI_BACKUP_BASE_URL 은 /chat/completions 앞부분까지 (예: https://openrouter.ai/api/v1)
# AI_BACKUP_BASE_URL=
# AI_BACKUP_API_KEY=
# AI_BACKUP_MODEL=        # 콤마로 여러 개 가능, 앞에서부터 시도
# 모델 고정(선택): 비우면 각 공급자의 모델 목록에서 자동 선택 (Gemini 는 Flash-Lite 우선)
# GEMINI_MODELS=
# GROQ_MODELS=

# AI 매매 신호 봇 (선택)
# AI_DAILY_BUDGET=60      # 봇 AI 평가 하루 호출 상한 (한국 날짜 기준). 다 쓰면 AI 봇은 그날 신규 진입 생략
# BOT_AI_INTERVAL=4       # 봇 AI 호출 사이 최소 간격(초). 무료 티어 분당 한도(429) 예방
# NOTIFY_PROVIDERS=inapp  # 알림 전달 방법 (콤마 구분). 지금은 inapp(사이트 안 알림)만 있음
# SCREENER_SCHEDULER=1    # 0 이면 스크리너 펀더멘탈 순환 갱신·첫 워밍업을 끈다 (가격·기술 지표는 섹터맵·봇 배치가 계속 갱신)
# SECTORMAP_SCHEDULER=1   # 0 이면 섹터맵 백그라운드 갱신을 끈다 (API 는 마지막 스냅샷 반환)
# TRENDS_SCHEDULER=1      # 0 이면 추세 셋업 표가 비었을 때의 첫 워밍업을 끈다 (장 마감 확정은 봇 배치가 계속 함)
# BOT_SCHEDULER=1         # 0 이면 장 마감 후 자동 배치를 끈다 (수동 실행은 /api/admin/bots/run)

# DART (전자공시시스템) — 한국 주식 분기 실적 (선택)
# https://opendart.fss.or.kr 에서 무료 발급
DART_API_KEY=your-dart-api-key

# 토스증권 Open API — 실시간 시세 / 캔들(차트) / 환율 (선택)
# https://developers.tossinvest.com 에서 발급
# 미설정 시 자동으로 yfinance/네이버로 폴백됩니다
TOSS_CLIENT_ID=your-toss-client-id
TOSS_CLIENT_SECRET=your-toss-client-secret
# 토스 계좌 import 권한 제한 (앱 소유자). 둘 중 하나로 지정 (콤마구분 복수 가능)
# - 이메일(구글 등): TOSS_OWNER_EMAIL=me@gmail.com,me2@gmail.com
# - user id(카카오는 이메일 미제공 → id 사용): TOSS_OWNER_USER_IDS=1,5
TOSS_OWNER_EMAIL=
TOSS_OWNER_USER_IDS=
# (선택) 고정 IP 프록시 — Railway egress IP가 재배포마다 바뀌는 문제 해결용.
# 프록시 IP를 토스 콘솔에 1회 등록하면 됨. 예: http://user:pass@host:3128
TOSS_PROXY_URL=

# 웹 푸시 (PWA 모바일·브라우저 알림, 선택). 비워 두면 푸시만 꺼지고 사이트 안 알림은 그대로 동작
# 키 만들기 (한 줄, pywebpush 설치 후):
#   python -c "from cryptography.hazmat.primitives.asymmetric import ec;from cryptography.hazmat.primitives import serialization as s;import base64;k=ec.generate_private_key(ec.SECP256R1());b=lambda x:base64.urlsafe_b64encode(x).rstrip(b'=').decode();print('VAPID_PUBLIC_KEY='+b(k.public_key().public_bytes(s.Encoding.X962,s.PublicFormat.UncompressedPoint)));print('VAPID_PRIVATE_KEY='+b(k.private_numbers().private_value.to_bytes(32,'big')))"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com   # 푸시 서비스가 문제 시 연락할 주소 (mailto: 또는 https://)
